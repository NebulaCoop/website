{
  // nebula.mackery.com on Cloudflare Workers: static files only, no Worker code (README.md, "Deploying").
  "name": "nebulacoop-website",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  // Deploying creates the DNS record, as long as mackery.com is a zone on the same Cloudflare account (as for
  // nebulanet.mackery.com).
  "routes": [{ "pattern": "nebula.mackery.com", "custom_domain": true }]
}
