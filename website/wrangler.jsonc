{
  // nebula.mackery.com on Cloudflare Workers: the built site (dist/) as static assets, no Worker code.
  // Workers Builds builds it from this folder (README.md, "Publishing").
  "name": "nebulaweb",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Any address with no page gets 404.html, with a 404 status.
    "not_found_handling": "404-page",
    // /coop and /coop/ both reach coop/index.html.
    "html_handling": "auto-trailing-slash",
  },
  // Deploying creates the DNS record, as long as mackery.com is a zone on the same Cloudflare account (as for
  // nebulanet.mackery.com).
  "routes": [{ "pattern": "nebula.mackery.com", "custom_domain": true }],
}
