{
  "name": "nebulacoop-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "blog:drafts": "npm run content && vite --host 127.0.0.1 --mode drafts",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test",
    "content": "node scripts/render-pages.mjs",
    "predev": "npm run content",
    "prebuild": "npm run content",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "npm run build && wrangler deploy",
    "cf:preview": "npm run build && wrangler dev",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "linkedom": "^0.18.15",
    "marked": "^18.2.0",
    "parse5": "^8.0.1",
    "prettier": "^3.9.10",
    "sharp": "^0.34.3",
    "vite": "^7.1.0",
    "wrangler": "^4.163.0"
  }
}
